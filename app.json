{
  "expo": {
    "name": "Pump Rise: Random",
    "slug": "piu-rise-random",
    "scheme": "pumpriserandom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AppIcons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pumpriserandom",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.pumpriserandom"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/AppIcons/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f54ef0cf-f5d8-4aef-b45a-fc3b0736803f"
      }
    },
    "owner": "coronels-organization"
  }
}
